# Copie para .env e ajuste.
PORT=3333
MONGODB_URI=mongodb://localhost:27017/lash

# Origens do front que podem chamar a API (separadas por vírgula).
WEB_ORIGIN=http://localhost:3000,https://lfsoftware.github.io
# Endereço público do front, usado nos links de redefinir senha.
WEB_URL=http://localhost:3000
# Endereço público desta API, usado nos links de download do armazenamento local.
API_URL=http://localhost:3333

# Troque por textos longos e aleatórios em produção.
JWT_SECRET=troque-este-segredo
JWT_REFRESH_SECRET=troque-este-outro-segredo
FILES_SECRET=troque-mais-este-segredo
# lax quando front e API estão no mesmo site; none (exige HTTPS) quando estão em domínios diferentes.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# WhatsApp da instrutora, só números com DDI.
WHATSAPP_INSTRUTORA=5511947692668

# Conta admin criada pelo seed.
ADMIN_NOME=Camilla Gama
ADMIN_EMAIL=camilla@example.com
ADMIN_SENHA=troque-esta-senha

# Arquivos (apostilas, materiais, capas): local ou s3 (S3, Cloudflare R2...).
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endereço público do bucket para as capas (opcional).
S3_PUBLIC_URL=

# Vídeos no Bunny Stream: com a chave, o link do player sai assinado e expira.
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
